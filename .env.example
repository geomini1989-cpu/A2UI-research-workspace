# 密钥仅供服务端使用。 / Keys are server-side only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=3001
HOST=127.0.0.1

# demo 为固定演示数据；sec 为获取的年度披露。 / demo uses fixtures; sec retrieves annual filings.
RESEARCH_PROVIDER=demo
# 使用 SEC 时填写项目名与真实联系邮箱。 / Supply your project name and real contact email for SEC.
SEC_USER_AGENT=

# 部署时必须设置以下三项；开发时可留空。 / All three are required in production, optional locally.
APP_ACCESS_KEY=
SESSION_SECRET=
PUBLIC_ORIGIN=
MAX_DAILY_RUNS=100

# 可选持久化位置；默认 .data。 / Optional storage directory; defaults to .data.
# DATA_DIR=.data
